# Copy this file to .env and fill in your details, or export these
# as real environment variables before running the app.
# Never commit the actual .env file.

SENDER_EMAIL=youraddress@gmail.com
SENDER_APP_PASSWORD=your16charapppassword

# Leave these as-is for Gmail prototyping. Change when you move to
# your domain mailbox (e.g. smtp.zoho.com / imap.zoho.com).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com

# Supabase Postgres connection string.
# Find it in Supabase: Project Settings -> Database -> Connection string.
# If your host is serverless/short-lived (e.g. Streamlit Community Cloud),
# use the "Connection pooling" string instead (port 6543).
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
